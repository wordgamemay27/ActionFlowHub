rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'wordgame.may27@gmail.com'
      );
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'telegramId', 'points', 'completedTasksCount', 'tier', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'telegramId', 'username', 'firstName', 'points', 'completedTasksCount', 'walletAddress', 'tier', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.telegramId is number && data.telegramId >= 0
        && (!('username' in data) || (data.username is string && data.username.size() <= 64))
        && (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 64))
        && data.points is number && data.points >= 0 && data.points <= 100000000
        && data.completedTasksCount is number && data.completedTasksCount >= 0 && data.completedTasksCount <= 1000000
        && (!('walletAddress' in data) || (data.walletAddress is string && data.walletAddress.size() <= 128))
        && data.tier in ['TIER 1', 'TIER 2', 'TIER 3', 'VIP ELITE']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // L'utente può creare il proprio profilo non-finanziario solo con saldi iniziali bloccati a zero
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().points == 0
        && incoming().completedTasksCount == 0
        && incoming().tier == 'TIER 1'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      // Punti, task completati e tier NON sono mai modificabili dal client/Firestore (fonte unica: PostgreSQL)
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().telegramId == existing().telegramId
        && incoming().points == existing().points
        && incoming().completedTasksCount == existing().completedTasksCount
        && incoming().tier == existing().tier
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'firstName', 'walletAddress', 'updatedAt']);
      allow delete: if false;

      // Transazioni finanziarie in sola lettura su Firestore: nessuna scrittura client consentita
      match /transactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create, update, delete: if false;
      }
    }

    match /test/connection {
      allow get: if true;
      allow write: if false;
    }
  }
}
