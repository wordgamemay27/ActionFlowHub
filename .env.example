# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# DATABASE & SECURITY VARIABLES (PostgreSQL Neon + Admin + Webhook)
# Never put real secrets or private keys in .env.example.
# ============================================================================
# DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=verify-full"
# PG_POOL_MAX="15"
# PG_ALLOW_SELF_SIGNED="false"
# ADMIN_API_TOKEN="your_admin_secret_token"
# ADMIN_SECONDARY_API_TOKEN="your_second_distinct_admin_token"
# ADMIN_SECONDARY_ID="admin_secondary"
# ADMIN_OPERATOR_TOKENS="admin_1:tok1,admin_2:tok2"
# ADMIN_TELEGRAM_IDS="123456789"
# PAYOUT_KILL_SWITCH="TRUE"
# PAYOUT_EXECUTION_MODE="MANUAL_EXTERNAL"
# ENABLE_AUTO_PAYOUT_DISPATCH="false"
# ONCHAIN_TX_VERIFY_REQUIRED="true"
# CASH_MANUAL_RECEIPT_ALLOW="false"
